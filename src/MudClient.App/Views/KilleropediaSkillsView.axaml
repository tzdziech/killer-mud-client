<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:controls="using:MudClient.App.Controls"
             xmlns:models="using:MudClient.App.Models"
             x:Class="MudClient.App.Views.KilleropediaSkillsView"
             x:DataType="vm:KilleropediaViewModel"
             Classes="killeropedia-page"
             x:Name="Root">
  <Grid RowDefinitions="Auto,*" RowSpacing="6">
    <Grid Grid.Row="0" ColumnDefinitions="*,200,Auto,Auto,Auto" ColumnSpacing="10">
      <TextBox Grid.Column="0"
               Text="{Binding AbilitySearchText, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Szukaj po nazwie, opisie, nauczycielu..." />
      <Button Grid.Column="1"
              Content="{Binding SelectedAbilityClassesSummaryText}"
              HorizontalContentAlignment="Left"
              HorizontalAlignment="Stretch"
              ToolTip.Tip="Wybierz jedną lub więcej klas, żeby połączyć ich umiejętności w jednym drzewie">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <Border Background="#1B140B" BorderBrush="#71552B" BorderThickness="1" CornerRadius="4" Padding="10">
              <ItemsControl ItemsSource="{Binding AbilityClassOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:AbilityClassOption">
                    <CheckBox Content="{Binding Name}"
                              Foreground="#D8C79D"
                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                              Command="{Binding #Root.((vm:KilleropediaViewModel)DataContext).ToggleAbilityClassCommand}"
                              CommandParameter="{Binding Name}"
                              Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBlock Grid.Column="2"
                 Classes="mud-faint"
                 Text="{Binding FilteredAbilityCountText}"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{Binding AbilitiesGeneratedText}" />
      <Button Grid.Column="3"
              Content="Resetuj widok"
              Click="OnResetViewClick"
              Padding="14,6"
              ToolTip.Tip="Cofnij przybliżenie/przesunięcie drzewa" />
      <Button Grid.Column="4"
              Content="Odśwież"
              Command="{Binding ReloadAbilitiesCommand}"
              Padding="14,6"
              ToolTip.Tip="Wczytaj ponownie ability-help.json po użyciu /mapuj w grze" />
    </Grid>

    <Border Grid.Row="1"
            Classes="mud-section"
            Padding="18"
            IsVisible="{Binding HasNoAbilities}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Classes="mud-heading-lg" Text="Brak zmapowanych umiejętności" HorizontalAlignment="Center" />
        <TextBlock Classes="mud-muted"
                   Text="Użyj „/mapuj &lt;klasa&gt;” w grze, aby przechwycić tekst pomocy skilli i czarów, a potem kliknij „Odśwież”."
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            CornerRadius="6"
            ClipToBounds="True"
            IsVisible="{Binding HasAbilities}">
      <Border.Background>
        <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.85" RadiusY="0.85">
          <GradientStop Offset="0" Color="#1B2036" />
          <GradientStop Offset="0.55" Color="#12162A" />
          <GradientStop Offset="1" Color="#08090F" />
        </RadialGradientBrush>
      </Border.Background>
      <controls:AbilitySkillTreeCanvas x:Name="TreeCanvas"
                                        ToolTip.Tip="Najedź kursorem na węzeł, żeby zobaczyć szczegóły — kliknij, żeby przypiąć."
                                        ToolTip.ShowDelay="0" />
    </Border>
  </Grid>
</UserControl>

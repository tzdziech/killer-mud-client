<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             xmlns:models="using:MudClient.App.Models"
             xmlns:b="using:MudClient.App.Behaviors"
             x:Class="MudClient.App.Views.KilleropediaArtifactsView"
             x:DataType="vm:KilleropediaViewModel"
             Classes="killeropedia-page"
             x:Name="Root">
  <TabControl Classes="mud-subtabs">
    <TabItem Header="Opisy przedmiotów (try)">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="0,8,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,200,Auto" ColumnSpacing="10">
          <TextBox Grid.Column="0"
                   Text="{Binding ArtifactSearchText, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Szukaj po nazwie, klasie, materiale..." />
          <Button Grid.Column="1"
                  Content="{Binding SelectedArtifactClassesSummaryText}"
                  HorizontalContentAlignment="Left"
                  HorizontalAlignment="Stretch"
                  ToolTip.Tip="Wybierz jedną lub więcej klas — pasujące przedmioty trafią na górę listy">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <Border Background="#1B140B" BorderBrush="#71552B" BorderThickness="1" CornerRadius="4" Padding="10">
                  <ItemsControl ItemsSource="{Binding ArtifactClassOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:AbilityClassOption">
                        <CheckBox Content="{Binding Name}"
                                  Foreground="#D8C79D"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding #Root.((vm:KilleropediaViewModel)DataContext).ToggleArtifactSortClassCommand}"
                                  CommandParameter="{Binding Name}"
                                  Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock Grid.Column="2"
                     Classes="mud-faint"
                     Text="{Binding FilteredArtifactCountText}"
                     VerticalAlignment="Center"
                     ToolTip.Tip="{Binding ArtifactsGeneratedText}" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Classes="mud-faint"
                   Text="Zaznacz klasę, żeby dopasowane przedmioty pokazały się na górze listy." />

        <Border Grid.Row="2"
                Classes="mud-section"
                Padding="18"
                IsVisible="{Binding HasNoArtifacts}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Classes="mud-heading-lg" Text="Brak zmapowanych przedmiotów" HorizontalAlignment="Center" />
            <TextBlock Classes="mud-muted"
                       Text="Użyj „/mapuj &lt;liczba&gt;” w grze, aby przechwycić opisy przedmiotów (komenda „try”)."
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="1*,3,2*"
              IsVisible="{Binding HasArtifacts}">
          <Border Grid.Column="0" Classes="mud-inset killeropedia-left-page" Padding="12">
            <ListBox ItemsSource="{Binding FilteredArtifacts}"
                     SelectedItem="{Binding SelectedArtifact}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ArtifactEntry">
                  <Border Padding="10,8" Margin="0,2" MinHeight="44" CornerRadius="3">
                    <StackPanel Spacing="3">
                      <TextBlock b:SearchHighlight.Text="{Binding Name}"
                                 b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).ArtifactSearchText}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 LineHeight="18" />
                      <TextBlock Classes="mud-faint"
                                 Text="{Binding ClassRestrictionText}"
                                 TextTrimming="CharacterEllipsis"
                                 LineHeight="15" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

          <Border Grid.Column="2" Classes="mud-section killeropedia-right-page" Padding="22">
            <ScrollViewer Classes="killeropedia-content-scroll">
              <StackPanel Spacing="12" DataContext="{Binding SelectedArtifact}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Classes="mud-heading-lg"
                             b:SearchHighlight.Text="{Binding Name}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).ArtifactSearchText}" />
                  <TextBlock Grid.Column="1"
                             Classes="mud-faint"
                             Text="{Binding Condition}"
                             VerticalAlignment="Center" />
                </Grid>

                <Border Classes="mud-inset" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="WAGA I MATERIAŁ" />
                    <TextBlock Text="{Binding WeightMaterialText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasClassRestriction}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="KLASY" />
                    <TextBlock Text="{Binding ClassRestrictionText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasRaceRestriction}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="RASY" />
                    <TextBlock Text="{Binding RaceRestrictionText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasAlignmentRestriction}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="ALIGNMENT" />
                    <TextBlock Text="{Binding AlignmentRestrictionText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasWeapon}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="BROŃ" />
                    <TextBlock Text="{Binding WeaponSummaryText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasArmor}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="PANCERZ" />
                    <TextBlock Text="{Binding ArmorSummaryText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasStatBonuses}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="CECHY" />
                    <TextBlock Text="{Binding StatBonusesText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasGrantedAbilities}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="DODAJE" />
                    <TextBlock Text="{Binding GrantedAbilitiesText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasSockets}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="GNIAZDA NA KAMIENIE MOCY" />
                    <TextBlock Text="{Binding SocketCount}" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding IsPartOfSet}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="CZĘŚĆ KOMPLETU" />
                    <TextBlock Text="{Binding SetMembersText}" TextWrapping="Wrap" />
                    <TextBlock Classes="mud-faint" Text="Bonus kompletu:" IsVisible="{Binding SetBonuses.Count}" />
                    <TextBlock Text="{Binding SetBonusesText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding IsIndestructible}">
                  <TextBlock Text="Przedmiot niezniszczalny." TextWrapping="Wrap" />
                </Border>

                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding IsCursed}">
                  <TextBlock Text="Przedmiot przeklęty — nie można się go pozbyć." TextWrapping="Wrap" />
                </Border>

                <TextBlock Classes="mud-heading" Text="PEŁNY OPIS (try &lt;n&gt;)" />
                <Border Classes="mud-inset" Padding="10">
                  <TextBlock b:SearchHighlight.Text="{Binding RawText}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).ArtifactSearchText}"
                             TextWrapping="Wrap" />
                </Border>

                <StackPanel Spacing="12"
                            DataContext="{Binding #Root.((vm:KilleropediaViewModel)DataContext).SelectedArtifactRareDetail}"
                            IsVisible="{Binding #Root.((vm:KilleropediaViewModel)DataContext).HasSelectedArtifactRareDetail}">
                  <TextBlock Classes="mud-heading" Text="ZNALEZIONO TAKŻE NA LIŚCIE RARELIST" />
                  <Border Classes="mud-inset" Padding="10">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="mud-heading" Text="TYP, SLOT I VNUM" />
                      <TextBlock Text="{Binding TypeSlotText}" TextWrapping="Wrap" />
                      <TextBlock Classes="mud-faint" Text="{Binding Vnum, StringFormat='vnum {0}'}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="mud-inset" Padding="10">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="mud-heading" Text="KATEGORIA" />
                      <TextBlock Text="{Binding CategoryText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasDetails}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="mud-heading" Text="SZCZEGÓŁY (rarelist &lt;vnum&gt;)" />
                      <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="Rzadkie przedmioty (rarelist)">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="0,8,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="*,160,Auto,Auto" ColumnSpacing="10">
          <TextBox Grid.Column="0"
                   Text="{Binding RareSearchText, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Szukaj po przedmiocie, typie, slocie lub vnum..." />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding AvailableRareCategories}"
                    SelectedItem="{Binding SelectedRareCategory}" />
          <TextBlock Grid.Column="2"
                     Classes="mud-faint"
                     Text="{Binding FilteredRareCountText}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="3"
                  Content="{Binding RareRefreshButtonText}"
                  Command="{Binding RefreshRaresCommand}"
                  IsVisible="{Binding IsRareRefreshButtonVisible}"
                  IsEnabled="{Binding IsRareRefreshEnabled}"
                  Padding="14,6"
                  ToolTip.Tip="Deweloperskie odtworzenie katalogu przez komendy rarelist" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Grid.Column="0"
                     Classes="mud-faint"
                     Text="{Binding RareRefreshStatus}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1"
                     Classes="mud-faint"
                     Text="{Binding RaresGeneratedText}" />
        </Grid>

        <Border Grid.Row="2"
                Classes="mud-section"
                Padding="18"
                IsVisible="{Binding HasNoRares}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Classes="mud-heading-lg" Text="Brak katalogu przedmiotów" HorizontalAlignment="Center" />
            <TextBlock Classes="mud-muted"
                       Text="Widok wczytuje wygenerowany plik killeropedia-rares.json."
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="1*,3,2*"
              IsVisible="{Binding HasRares}">
          <Border Grid.Column="0" Classes="mud-inset killeropedia-left-page" Padding="12">
            <ListBox ItemsSource="{Binding FilteredRares}"
                     SelectedItem="{Binding SelectedRare}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:RareEntry">
                  <Border Padding="10,8" Margin="0,2" MinHeight="44" CornerRadius="3">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="3">
                      <TextBlock Grid.Row="0" Grid.Column="0"
                                 b:SearchHighlight.Text="{Binding Name}"
                                 b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).RareSearchText}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 LineHeight="18" />
                      <TextBlock Grid.Row="0" Grid.Column="1"
                                 Classes="mud-faint"
                                 Text="{Binding Vnum, StringFormat='vnum {0}'}" />
                      <TextBlock Grid.Row="1" Grid.Column="0"
                                 Classes="mud-faint"
                                 b:SearchHighlight.Text="{Binding TypeSlotText}"
                                 b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).RareSearchText}"
                                 TextTrimming="CharacterEllipsis"
                                 LineHeight="15" />
                      <TextBlock Grid.Row="1" Grid.Column="1"
                                 Classes="mud-faint"
                                 Text="{Binding CategoryText}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

          <Border Grid.Column="2" Classes="mud-section killeropedia-right-page" Padding="22">
            <ScrollViewer Classes="killeropedia-content-scroll">
              <StackPanel Spacing="12" DataContext="{Binding SelectedRare}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Classes="mud-heading-lg"
                             b:SearchHighlight.Text="{Binding Name}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).RareSearchText}" />
                  <TextBlock Grid.Column="1"
                             Classes="mud-faint"
                             Text="{Binding Vnum, StringFormat='Vnum: {0}'}"
                             VerticalAlignment="Center" />
                </Grid>

                <Border Classes="mud-inset" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="TYP I SLOT" />
                    <TextBlock b:SearchHighlight.Text="{Binding TypeSlotText}"
                               b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).RareSearchText}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="mud-inset" Padding="10">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="mud-heading" Text="KATEGORIA" />
                    <TextBlock Text="{Binding CategoryText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <TextBlock Classes="mud-heading" Text="SZCZEGÓŁY (rarelist &lt;vnum&gt;)" />
                <TextBlock Classes="mud-faint"
                           Text="Brak przechwyconych szczegółów — kliknij „Odśwież” będąc połączonym z grą."
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasDetails}" />
                <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasDetails}">
                  <TextBlock b:SearchHighlight.Text="{Binding Details}"
                             b:SearchHighlight.Terms="{Binding #Root.((vm:KilleropediaViewModel)DataContext).RareSearchText}"
                             TextWrapping="Wrap" />
                </Border>

                <StackPanel Spacing="12"
                            DataContext="{Binding #Root.((vm:KilleropediaViewModel)DataContext).SelectedRareArtifactDetail}"
                            IsVisible="{Binding #Root.((vm:KilleropediaViewModel)DataContext).HasSelectedRareArtifactDetail}">
                  <TextBlock Classes="mud-heading" Text="ZNALEZIONO TAKŻE OPIS „TRY” DLA TEGO PRZEDMIOTU" />
                  <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasClassRestriction}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="mud-heading" Text="KLASY" />
                      <TextBlock Text="{Binding ClassRestrictionText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="mud-inset" Padding="10" IsVisible="{Binding HasStatBonuses}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="mud-heading" Text="CECHY" />
                      <TextBlock Text="{Binding StatBonusesText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="mud-inset" Padding="10">
                    <TextBlock Text="{Binding RawText}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>

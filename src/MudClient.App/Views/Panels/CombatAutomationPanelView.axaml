<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MudClient.App.ViewModels"
             x:Class="MudClient.App.Views.Panels.CombatAutomationPanelView"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8" Margin="10,8,10,12">
      <TextBlock Classes="mud-heading" Text="Automatyczne reakcje w walce" />
      <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                 Text="Twarde reakcje na konkretne sytuacje w walce — nie są to reguły triggerów, więc nie pojawiają się na liście Triggery." />

      <Border Classes="mud-section" Padding="10">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutoStandOnLyingEnabled}"
                      Content="Autostand — wstań, gdy zostaniesz powalony" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy Twoja pozycja GMCP zmieni się na „leży”, albo pojawi się komunikat „powala cię na ziemię”/„przewracasz się”/„osuwasz się półprzytomny”, klient wyśle „stand”." />
          </StackPanel>

          <Border Height="1" Background="{StaticResource MudBrushSlate}" Margin="0,4" />

          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding AutowieldEnabled}"
                      Content="Autowield — podnieś i załóż broń po rozbrojeniu" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Gdy pojawi się komunikat „rozbraja cię”, klient wyśle „get &lt;broń&gt;”, a potem „wield &lt;broń&gt;”." />
            <TextBlock Margin="0,6,0,0" Text="Nazwa broni" />
            <TextBox Text="{Binding AutowieldWeaponName, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Np. miecz" />
            <TextBlock Classes="mud-faint" TextWrapping="Wrap"
                       Text="Dokładna nazwa Twojej broni, używana w komendach get/wield." />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

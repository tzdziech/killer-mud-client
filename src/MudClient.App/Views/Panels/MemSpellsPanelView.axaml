<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MudClient.App.ViewModels" xmlns:models="using:MudClient.App.Models" xmlns:conv="using:MudClient.App.Converters" x:Class="MudClient.App.Views.Panels.MemSpellsPanelView" x:DataType="vm:MainWindowViewModel">
 <UserControl.Styles>
  <Style Selector="Border.effect-entry"><Setter Property="BorderBrush" Value="{StaticResource MudBrushEmerald}" /></Style>
  <Style Selector="Border.effect-entry.debuff, Border.effect-entry.ending"><Setter Property="BorderBrush" Value="{StaticResource MudBrushCrimson}" /></Style>
  <Style Selector="TextBlock.effect-icon"><Setter Property="Foreground" Value="{StaticResource MudBrushEmeraldBright}" /></Style>
  <Style Selector="TextBlock.effect-icon.debuff, TextBlock.effect-icon.ending, TextBlock.effect-name.debuff"><Setter Property="Foreground" Value="{StaticResource MudBrushCrimsonBright}" /></Style>
 </UserControl.Styles>
 <ScrollViewer><StackPanel Spacing="10" Margin="12">
  <StackPanel Spacing="4">
   <TextBlock Classes="mud-heading" Text="Kondycja" />
   <TextBlock Classes="mud-faint" Text="W pełni sił — brak dolegliwości." IsVisible="{Binding !Conditions.Count}" />
   <ItemsControl ItemsSource="{Binding Conditions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Border Background="{StaticResource MudBrushStoneLight}" BorderBrush="{StaticResource MudBrushCrimson}" BorderThickness="1" CornerRadius="3" Padding="7,3" Margin="0,2,4,2"><TextBlock Text="{Binding}" Foreground="{StaticResource MudBrushCrimsonBright}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <StackPanel Spacing="4">
   <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="mud-heading" Text="Własne buffy" VerticalAlignment="Center" /><Border Grid.Column="1" Classes="mud-badge"><TextBlock Text="{Binding BuffsBadge}" /></Border></Grid>
   <Button Content="RZUĆ BRAKUJĄCE" Classes="mud-small" HorizontalAlignment="Stretch" ToolTip.Tip="/recast działa na aktywnym zestawie" Command="{Binding RecastBuffsCommand}" />
   <TextBlock Classes="mud-faint" Text="Ten zestaw jest pusty." HorizontalAlignment="Center" Margin="6,8" IsVisible="{Binding !RequiredBuffs.Count}" />
   <ItemsControl ItemsSource="{Binding RequiredBuffs}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[UserControl].DataContext.BuffColumnsCount}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:BuffWatchEntry"><Grid>
     <Button BorderBrush="{Binding IsActive, Converter={x:Static conv:BoolToResourceBrushConverter.Instance}, ConverterParameter=MudBrushEmerald|MudBrushCrimson}" Background="{Binding IsListedInMemSpell, Converter={x:Static conv:BoolToResourceBrushConverter.Instance}, ConverterParameter=MudBrushStone|MudBrushAshBg}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand" ToolTip.Tip="Rzuć ten spell" IsEnabled="{Binding IsListedInMemSpell}" Command="{Binding $parent[UserControl].DataContext.RecastSingleBuffCommand}" CommandParameter="{Binding}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,30,0">
       <TextBlock Text="[+]" Foreground="{StaticResource MudBrushEmeraldBright}" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding IsActive}" /><TextBlock Text="[-]" Foreground="{StaticResource MudBrushCrimsonBright}" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding !IsActive}" />
       <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding IsListedInMemSpell, Converter={x:Static conv:BoolToResourceBrushConverter.Instance}, ConverterParameter=MudBrushParchment|MudBrushAsh}" VerticalAlignment="Center" />
       <TextBlock Grid.Column="2" Text="{Binding SmartBuffTimerText}" IsVisible="{Binding IsSmartBuffTimerVisible}" Foreground="{Binding IsSmartBuffTimerHighConfidence, Converter={x:Static conv:BoolToResourceBrushConverter.Instance}, ConverterParameter=MudBrushEmeraldBright|MudBrushAmberWarn}" ToolTip.Tip="{Binding SmartBuffTimerToolTip}" FontFamily="Consolas" Margin="0,0,6,0" VerticalAlignment="Center" />
       <StackPanel Grid.Column="3" Orientation="Horizontal" IsVisible="{Binding IsListedInMemSpell}" Margin="0,0,6,0"><TextBlock Text="[" Foreground="{Binding IsReadyBracketGreen, Converter={x:Static conv:BoolToResourceBrushConverter.Instance}, ConverterParameter=MudBrushEmeraldBright|MudBrushCrimsonBright}" /><TextBlock Text="{Binding MemoizedCount}" Foreground="{StaticResource MudBrushEmeraldBright}" /><TextBlock Text="/" Classes="mud-faint" /><TextBlock Text="{Binding UsedCount}" Foreground="{StaticResource MudBrushCrimsonBright}" /><TextBlock Text="]" Foreground="{Binding IsReadyBracketGreen, Converter={x:Static conv:BoolToResourceBrushConverter.Instance}, ConverterParameter=MudBrushEmeraldBright|MudBrushCrimsonBright}" /></StackPanel>
      </Grid>
     </Button>
     <Button Content="✕" Classes="mud-small" Padding="6,1" Margin="0,1,6,1" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="Usuń z zestawu" Command="{Binding $parent[UserControl].DataContext.DeleteBuffCommand}" CommandParameter="{Binding}" />
    </Grid></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
  <StackPanel Spacing="2">
   <TextBlock Classes="mud-heading" Text="Inne efekty" />
   <TextBlock Classes="mud-faint" Text="Brak innych aktywnych efektów." IsVisible="{Binding !OtherEffects.Count}" />
   <ItemsControl ItemsSource="{Binding OtherEffects}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:StatusEffect"><Border Classes="effect-entry" Classes.debuff="{Binding IsDebuff}" Classes.ending="{Binding Ending}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,1"><Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"><TextBlock Classes="effect-icon" Classes.debuff="{Binding IsDebuff}" Classes.ending="{Binding Ending}" Text="{Binding Icon}" Margin="0,0,6,0" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><TextBlock Classes="effect-name" Classes.debuff="{Binding IsDebuff}" Text="{Binding Name}" ToolTip.Tip="{Binding Description}" /><TextBlock Text="{Binding Duration, StringFormat='({0})'}" Classes="mud-faint" IsVisible="{Binding HasDuration}" /></StackPanel><TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Description}" Classes="mud-faint" TextTrimming="CharacterEllipsis" IsVisible="{Binding $parent[ItemsControl].DataContext.ShowExtendedEffects}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
  <Expander Header="Zapamiętane zaklęcia" IsExpanded="{Binding IsMemSpellsSectionVisible, Mode=TwoWay}"><StackPanel Spacing="2" Margin="0,6,0,0">
   <TextBlock Classes="mud-faint" Text="Brak zapamiętanych zaklęć." IsVisible="{Binding !MemSpells.Count}" />
   <ItemsControl ItemsSource="{Binding MemSpells}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:MemSpellCircle"><Border Classes="mud-section" Padding="6,3" Margin="0,1"><WrapPanel><TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{StaticResource MudBrushArcaneBlueBright}" Margin="0,0,4,0" /><TextBlock Text="{Binding MemedCount}" ToolTip.Tip="Zapamiętane" /><TextBlock Text="/" Classes="mud-faint" /><TextBlock Text="{Binding UnmemedCount}" Foreground="{StaticResource MudBrushCrimsonBright}" Margin="0,0,8,0" ToolTip.Tip="Użyte / niezapamiętane" /><TextBlock Text="{Binding MemedDisplay}" IsVisible="{Binding HasMemed}" Margin="0,0,8,0" ToolTip.Tip="Zapamiętane" /><TextBlock Text="{Binding MemingDisplay}" Foreground="{StaticResource MudBrushGoldBright}" IsVisible="{Binding HasMeming}" Margin="0,0,8,0" ToolTip.Tip="W trakcie zapamiętywania" /><TextBlock Text="{Binding UnmemedDisplay}" Foreground="{StaticResource MudBrushCrimsonBright}" IsVisible="{Binding HasUnmemed}" ToolTip.Tip="Rzucone / niezapamiętane" /></WrapPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Expander>
  <StackPanel IsVisible="{Binding AbilityMonitoringEnabled}">
  <Expander Header="Znane skille" IsExpanded="{Binding IsKnownSkillsSectionVisible, Mode=TwoWay}"><StackPanel Spacing="2" Margin="0,6,0,0">
   <TextBlock Classes="mud-faint" Text="Brak danych — lista odświeży się po zalogowaniu." IsVisible="{Binding !KnownSkillLevels.Count}" />
   <TextBlock Classes="mud-faint" Text="Złoty: wyuczenie • zielony: przedmioty • niebieski: wykupione punkty nauczycieli • biały: do 100" TextWrapping="Wrap" />
   <ItemsControl ItemsSource="{Binding KnownSkillLevels}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:KnownSkillLevel"><StackPanel Spacing="2"><TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{StaticResource MudBrushGoldBright}" /><ItemsControl ItemsSource="{Binding Skills}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:KnownSkillEntry"><Border Classes="mud-section" Padding="6,3" Margin="0,1" ToolTip.Tip="{Binding TrainingProgressToolTip}"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding Name}" Foreground="{StaticResource MudBrushParchment}" ToolTip.Tip="{Binding HistoryToolTip}" /><TextBlock Text="{Binding MindLimitDisplay}" Foreground="{StaticResource MudBrushAmberWarn}" FontSize="10" FontWeight="Bold" IsVisible="{Binding IsMindLimited}" ToolTip.Tip="{Binding MindLimitToolTip}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" ToolTip.Tip="{Binding TrainingProgressToolTip}"><TextBlock Text="{Binding CurrentDisplay}" FontFamily="Consolas" Foreground="{StaticResource MudBrushGoldBright}" FontWeight="Bold" ToolTip.Tip="Wyuczenie trwałe" /><TextBlock Text="{Binding ItemBonusDisplay}" FontFamily="Consolas" Foreground="{StaticResource MudBrushEmeraldBright}" FontWeight="Bold" IsVisible="{Binding HasItemBonus}" ToolTip.Tip="{Binding ItemBonusToolTip}" /><TextBlock Text="=" Classes="mud-faint" IsVisible="{Binding HasItemBonus}" /><TextBlock Text="{Binding EffectiveDisplay}" FontFamily="Consolas" Foreground="{StaticResource MudBrushEmeraldBright}" FontWeight="Bold" IsVisible="{Binding HasItemBonus}" ToolTip.Tip="{Binding ItemBonusToolTip}" /></StackPanel><Grid Grid.Row="1" Grid.ColumnSpan="2" Height="5" Margin="0,3,0,2" ToolTip.Tip="{Binding TrainingProgressToolTip}"><ProgressBar Minimum="0" Maximum="{Binding TrainingBarMaximum}" Value="{Binding PotentialTrainingLevel}" Foreground="{StaticResource MudBrushArcaneBlue}" Background="{StaticResource MudBrushParchment}" /><ProgressBar Minimum="0" Maximum="{Binding TrainingBarMaximum}" Value="{Binding EffectiveLevel}" Foreground="{StaticResource MudBrushEmerald}" Background="Transparent" /><ProgressBar Minimum="0" Maximum="{Binding TrainingBarMaximum}" Value="{Binding Current}" Foreground="{StaticResource MudBrushGold}" Background="Transparent" /></Grid><TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TeacherReserveDisplay}" Foreground="{StaticResource MudBrushArcaneBlueBright}" FontSize="10" IsVisible="{Binding HasTeacherReserve}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Expander>
  <Expander Header="Znane spelle" IsExpanded="{Binding IsKnownSpellsSectionVisible, Mode=TwoWay}"><StackPanel Spacing="2" Margin="0,6,0,0">
   <TextBlock Classes="mud-faint" Text="Brak danych — lista odświeży się po zalogowaniu." IsVisible="{Binding !KnownSpellCircles.Count}" />
   <ItemsControl ItemsSource="{Binding KnownSpellCircles}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:KnownSpellCircle"><StackPanel Spacing="2"><TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{StaticResource MudBrushArcaneBlueBright}" /><ItemsControl ItemsSource="{Binding Spells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:KnownSpellEntry"><Border Classes="mud-section" Padding="6,3" Margin="0,1"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="{Binding ValueDisplay}" FontFamily="Consolas" Foreground="{StaticResource MudBrushArcaneBlueBright}" Margin="0,0,8,0" ToolTip.Tip="Poziom rzucania" /><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource MudBrushParchment}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Expander>
  <Expander Header="Brakujące spelle"><StackPanel Spacing="2" Margin="0,6,0,0">
   <TextBlock Classes="mud-faint" Text="Lista odświeża się po zalogowaniu." TextWrapping="Wrap" />
   <TextBlock Classes="mud-faint" Text="Brak danych o czarach możliwych do nauczenia." IsVisible="{Binding !MissingSpellCircles.Count}" />
   <ItemsControl ItemsSource="{Binding MissingSpellCircles}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:MissingSpellCircle"><StackPanel Spacing="2"><TextBlock Text="{Binding Header}" FontWeight="Bold" Foreground="{StaticResource MudBrushCrimsonBright}" /><ItemsControl ItemsSource="{Binding Spells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:MissingSpellEntry"><Border Classes="mud-section" Padding="6,3" Margin="0,1"><TextBlock Text="{Binding Name}" Foreground="{StaticResource MudBrushParchment}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Expander>
  <Expander Header="Historia rozwoju skilli"><StackPanel Spacing="2" Margin="0,6,0,0">
   <TextBlock Classes="mud-faint" Text="Zapisuje tylko komunikaty: ‘Stajesz się lepszy w umiejętności…’." TextWrapping="Wrap" />
   <TextBlock Classes="mud-faint" Text="Brak zapisanych popraw skilli." IsVisible="{Binding !SkillProgressHistory.Count}" />
   <ItemsControl ItemsSource="{Binding SkillProgressHistory}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SkillProgressHistoryEntry"><Border Classes="mud-section" Padding="6,3" Margin="0,1" ToolTip.Tip="{Binding ToolTip}"><Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"><TextBlock Text="{Binding WhenDisplay}" Classes="mud-faint" Margin="0,0,8,0" /><TextBlock Grid.Column="1" Text="{Binding SkillName}" Foreground="{StaticResource MudBrushParchment}" /><TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontFamily="Consolas" Foreground="{StaticResource MudBrushGoldBright}" /><TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ContextDisplay}" Classes="mud-faint" TextTrimming="CharacterEllipsis" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Expander>
  </StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
